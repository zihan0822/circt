module {
  hw.module @mem_two_addr(in %clk : i1, in %data_in : i8, out data_out0 : i8, out data_out1 : i8, in %rd_addr : i2, in %wr_addr : i2) {
    %c7_i8 = hw.constant 7 : i8
    %0 = seq.const_clock  low
    %mem0 = seq.firmem 0, 1, undefined, port_order {prefix = ""} : <4 x 8>
    %1 = seq.firmem.read_port %mem0[%rd_addr], clock %0 : <4 x 8>
    seq.firmem.write_port %mem0[%wr_addr] = %data_in, clock %4 : <4 x 8>
    %mem1 = seq.firmem 0, 1, undefined, port_order {prefix = ""} : <4 x 8>
    %2 = seq.firmem.read_port %mem1[%rd_addr], clock %0 : <4 x 8>
    seq.firmem.write_port %mem1[%wr_addr] = %3, clock %4 : <4 x 8>
    %3 = comb.add %data_in, %c7_i8 {sv.namehint = "_add_verilog_rw_sv_14_10"} : i8
    %4 = seq.to_clock %clk
    hw.output %1, %2 : i8, i8
  }
  om.class @mem_two_addr_Class(%basepath: !om.basepath) {
  }
}

