1 sort bitvec 1
2 input 1 reset
3 sort bitvec 3
4 input 3 addr
5 sort bitvec 64
6 input 5 wdata
7 input 1 wen
8 sort bitvec 8
9 input 8 wmask
10 sort array 3 5
11 state 10 
12 read 5 11 4
13 slice 1 9 0 0
14 and 1 7 13
15 output 12 rdata
16 write 10 11 4 6
17 ite 10 14 16 11
18 next 10 11 17
module {
  hw.module @ArrayTest(in %clock : !seq.clock, in %reset : i1, in %addr : i3, in %wdata : i64, in %wen : i1, in %wmask : i8, out rdata : i64) {
    %mem = seq.firmem 0, 1, undefined, port_order {prefix = ""} : <8 x 64>
    %0 = seq.firmem.read_port %mem[%addr], clock %clock : <8 x 64>
    %1 = comb.and bin %wen, %2 : i1
    seq.firmem.write_port %mem[%addr] = %wdata, clock %clock enable %1 : <8 x 64>
    %2 = comb.extract %wmask from 0 : (i8) -> i1
    hw.output %0 : i64
  }
  om.class @ArrayTest_Class(%basepath: !om.basepath) {
  }
}

